{
  // Shared settings for the API (api/, server/). NodeNext matches how Vercel runs the function (native Node ESM),
  // so a relative import without a .js extension is a type error here instead of a runtime crash.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
